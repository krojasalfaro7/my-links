rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dueño: sus dos cuentas de Firebase Auth, por UID (Google y clave de correo/contraseña).
    function esDueno() {
      return request.auth != null && request.auth.uid in [
        "LbhMNg8aA6dgDqcQadTnRVHKn633",   // Google: krojas.alfaro7@gmail.com
        "ge429UVXVzgcjPgkJkQq2RCQyHx1"    // Clave: krojas.alfaro7+links@gmail.com
      ];
    }
    // Links públicos: cualquiera lee, solo el dueño escribe.
    match /links_publicos/{id} {
      allow read: if true;
      allow write: if esDueno();
    }
    // Links privados y categorías: solo el dueño.
    match /links_privados/{id} {
      allow read, write: if esDueno();
    }
    match /config/{doc} {
      allow read: if true;
      allow write: if esDueno();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
